# --- Claude ---
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Where call notes go: twenty | hubspot | file | none ---
CRM=file
# Local output folder for the file adapter and email drafts
OUT_DIR=out
# Which next steps become CRM tasks: us (default, ours only) | all
TASK_OWNER_FILTER=us

# --- Twenty CRM (https://twenty.com) ---
# Cloud: https://api.twenty.com   Self-hosted: https://crm.yourdomain.com
TWENTY_BASE_URL=https://api.twenty.com
TWENTY_API_KEY=
# Map suggested stages to your opportunity stage values (only used with --update-stage)
TWENTY_STAGE_MAP={"discovery":"SCREENING","qualification":"MEETING","proposal":"PROPOSAL","closed_won":"CUSTOMER"}

# --- HubSpot (private app access token) ---
HUBSPOT_ACCESS_TOKEN=
# Map suggested stages to your pipeline's internal dealstage ids (only used with --update-stage)
HUBSPOT_STAGE_MAP={"discovery":"appointmentscheduled","qualification":"qualifiedtobuy","proposal":"presentationscheduled","negotiation":"contractsent","closed_won":"closedwon","closed_lost":"closedlost"}
# Optional: assign notes and tasks to this owner
HUBSPOT_OWNER_ID=

# --- You (used to tell the two sides apart and to sign emails) ---
SENDER_NAME=Sox
SENDER_TITLE=Sales Director
SENDER_COMPANY=
# Optional: your own style profile for follow-up emails
STYLE_PATH=

# --- HTTP server (npm start) ---
PORT=3000
# Required in production: clients send Authorization: Bearer <APP_API_KEY>
APP_API_KEY=
