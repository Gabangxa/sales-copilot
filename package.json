{
  "name": "sales-copilot",
  "version": "0.2.0",
  "description": "Turn sales call notes into CRM updates and draft follow-up emails with Claude.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sales-copilot": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/server.js",
    "serve:dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "commander": "^15.0.0",
    "mammoth": "^1.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
